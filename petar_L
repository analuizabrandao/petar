# 5. PCoA — Weighted UniFrac (using PETAR tree)
# ============================================================

cat("\n[5] Weighted UniFrac PCoA\n")

# Load tree
tree_petar_L <- qza_to_phyloseq(
  features = "C:/Users/anapo/Desktop/docdir/cbo/petar/table.qza",
  tree     = "C:/Users/anapo/Desktop/docdir/cbo/petar/rooted-tree.qza"
) %>% phy_tree()

# Prune to shared ASVs
shared_asvs    <- intersect(taxa_names(PETAR_L), tree_petar_L$tip.label)
cat(paste0("  Shared ASVs (PETAR_L + tree): ", length(shared_asvs), "\n"))

PETAR_L_tree         <- prune_taxa(shared_asvs, PETAR_L)
tree_petar_L_pruned  <- keep.tip(tree_petar_L, shared_asvs)
PETAR_L_wt           <- merge_phyloseq(PETAR_L_tree, tree_petar_L_pruned)

# Calculate Weighted UniFrac
wunifrac_dist <- UniFrac(PETAR_L_wt, weighted = TRUE, normalized = TRUE, parallel = FALSE)

# PCoA
pcoa_res  <- cmdscale(wunifrac_dist, k = 2, eig = TRUE)
eig       <- pcoa_res$eig
var_exp   <- round(eig / sum(eig[eig > 0]) * 100, 2)
pc1_label <- paste0("PC1 (", var_exp[1], "%)")
pc2_label <- paste0("PC2 (", var_exp[2], "%)")

pcoa_df <- data.frame(
  PC1      = pcoa_res$points[, 1],
  PC2      = pcoa_res$points[, 2],
  SampleID = rownames(pcoa_res$points)
)

meta_df          <- data.frame(sample_data(PETAR_L_wt))
meta_df$SampleID <- rownames(meta_df)

pcoa_df <- left_join(pcoa_df,
                     meta_df[, c("SampleID", "Core.depth")],
                     by = "SampleID")
pcoa_df$Core.depth <- factor(pcoa_df$Core.depth, levels = depth_levels)

# PERMANOVA
meta_ordered <- meta_df[match(rownames(as.matrix(wunifrac_dist)), meta_df$SampleID), ]
perm_result  <- adonis2(wunifrac_dist ~ Core.depth, data = meta_ordered, permutations = 999)
cat("\nPERMANOVA result:\n"); print(perm_result)

r2_val  <- round(perm_result$R2[1], 3)
p_val   <- perm_result$`Pr(>F)`[1]
p_label <- ifelse(p_val < 0.001, "p < 0.001",
                  ifelse(p_val < 0.01,  "p < 0.01",
                         ifelse(p_val < 0.05,  "p < 0.05",
                                paste0("p = ", round(p_val, 3)))))
permanova_label <- paste0("PERMANOVA\nR² = ", r2_val, ", ", p_label)

# Plot
pcoa_plot <- ggplot(pcoa_df,
                    aes(x = PC1, y = PC2, color = Core.depth, label = SampleID)) +
  geom_point(size = 4.5, alpha = 0.95) +
  geom_text(vjust = -0.9, size = 3, color = "black", show.legend = FALSE, fontface = "italic") +
  annotate("text", x = Inf, y = -Inf, label = permanova_label,
           hjust = 1.05, vjust = -0.5, size = 4, fontface = "italic") +
  scale_color_manual(values = depth_col_vec, name = "Core Depth (cm)") +
  labs(title = "PCoA — Weighted UniFrac — PETAR LABORATÓRIO (Caves)",
       x = pc1_label, y = pc2_label) +
  theme_classic() +
  theme(
    text            = element_text(family = "Liberation Serif", size = 13),
    plot.title      = element_text(hjust = 0.5, face = "bold", size = 16),
    legend.position = "right",
    legend.title    = element_text(size = 12, face = "bold"),
    legend.text     = element_text(size = 10),
    axis.text       = element_text(size = 11, color = "black"),
    axis.title      = element_text(size = 13, face = "bold"),
    axis.line       = element_line(color = "black", linewidth = 0.7),
    plot.margin     = margin(12, 12, 12, 12)
  )

print(pcoa_plot)
ggsave("PETAR__L_pcoa_wunifrac.png", plot = pcoa_plot,

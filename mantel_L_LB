# ============================================================
# STEP 4: Find top 10 most abundant Phyla per group (L or LB)
# Done inside run_mantel_plot() per dataset
# ============================================================

get_top10_phyla <- function(ps, label) {
  ps_phylum    <- tax_glom(ps, taxrank = "Phylum", NArm = TRUE)
  phylum_sums  <- taxa_sums(ps_phylum)
  phylum_names <- as.character(tax_table(ps_phylum)[, "Phylum"])
  names(phylum_names) <- names(phylum_sums)
  top10_ids    <- names(sort(phylum_sums, decreasing = TRUE))[1:min(10, length(phylum_sums))]
  top10_names  <- phylum_names[top10_ids]
  cat(paste0("\nTop 10 Phyla for ", label, ":\n"))
  for (i in seq_along(top10_names)) {
    cat(paste0("  Spec", sprintf("%02d", i), ": ", top10_names[i], "\n"))
  }
  return(top10_names)
}

# ============================================================
# STEP 5: Build OTU matrix function (samples x ASVs)
# ============================================================

build_otu_matrix <- function(ps) {
  otu_mat <- as.data.frame(t(otu_table(ps)))  # samples x ASVs
  # Relative abundance
  otu_rel <- otu_mat / rowSums(otu_mat)
  return(otu_rel)
}

# ============================================================
# STEP 6: Build spec_select indices per Phylum
# ============================================================

build_spec_select <- function(ps, top10_phyla_names) {
  otu_rel  <- build_otu_matrix(ps)
  tax_df   <- as.data.frame(tax_table(ps))
  
  spec_select <- list()
  for (i in seq_along(top10_phyla_names)) {
    asv_ids <- rownames(tax_df)[tax_df$Phylum == top10_phyla_names[i]]
    asv_ids <- intersect(asv_ids, colnames(otu_rel))
    if (length(asv_ids) > 0) {
      idx <- which(colnames(otu_rel) %in% asv_ids)
      spec_select[[paste0("Spec", sprintf("%02d", i))]] <- idx
    }
  }
  return(list(otu_rel = otu_rel, spec_select = spec_select))
}

# ============================================================
# STEP 7: Build environmental matrix function
# ============================================================

build_env_matrix <- function(ps) {
  meta <- data.frame(sample_data(ps))
  
  # Select geochemical environmental variables only
  env_vars <- c("MgO", "Al2O3", "SiO2", "P", "S", "Cl",
                "K2O", "Ca", "Ti", "V", "Cr", "Mn", "Fe")
  
  # Keep only columns that exist in metadata
  env_vars <- env_vars[env_vars %in% colnames(meta)]
  
  env_mat <- meta[, env_vars, drop = FALSE]
  
  # Convert to numeric and remove columns with all NA
  env_mat <- as.data.frame(lapply(env_mat, as.numeric))
  rownames(env_mat) <- rownames(meta)
  env_mat <- env_mat[, colSums(!is.na(env_mat)) > 1, drop = FALSE]
  
  # Remove rows with any NA (needed for Mantel)
  env_mat <- env_mat[complete.cases(env_mat), , drop = FALSE]
  
  cat(paste0("  Environmental variables used: ",
             paste(colnames(env_mat), collapse = ", "), "\n"))
  
  return(env_mat)
}

# ============================================================
# STEP 8: Run Mantel + Plot function
# ============================================================

run_mantel_plot <- function(ps, label, out_file) {
  
  cat(paste0("\n--- Running linkET Mantel for: ", label, " ---\n"))
  
  # Get top 10 Phyla specific to this group (L or LB)
  top10_names_local <- get_top10_phyla(ps, label)
  
  # Build OTU and spec_select
  spec_data <- build_spec_select(ps, top10_names_local)
  otu_rel   <- spec_data$otu_rel
  spec_sel  <- spec_data$spec_select
  
  if (length(spec_sel) < 2) {
    cat("  Not enough Phyla for analysis\n")
    return(NULL)
  }
  
  # Build env matrix
  env_mat <- build_env_matrix(ps)
  
  if (nrow(env_mat) < 3) {
    cat("  Not enough samples with complete environmental data\n")
    return(NULL)
  }
  
  # Align samples between otu and env
  common_samples <- intersect(rownames(otu_rel), rownames(env_mat))
  cat(paste0("  Samples used: ", length(common_samples), "\n"))
  
  otu_sub <- otu_rel[common_samples, , drop = FALSE]
  env_sub <- env_mat[common_samples, , drop = FALSE]
  
  # Update spec_select indices after subsetting rows
  # (column indices remain the same)
  
  # Run Mantel test
  mantel <- linkET::mantel_test(
    spec        = otu_sub,
    env         = env_sub,
    spec_select = spec_sel
  ) %>%
    mutate(
      rd = cut(r,
               breaks = c(-Inf, 0.2, 0.4, Inf),
               labels = c("< 0.2", "0.2 - 0.4", ">= 0.4")),
      pd = cut(p,
               breaks = c(-Inf, 0.01, 0.05, Inf),
               labels = c("< 0.01", "0.01 - 0.05", ">= 0.05"))
    )
  
  cat("  Mantel results:\n")
  print(mantel)
  
  # Replace Spec names with Phylum names in mantel results
  spec_name_map <- setNames(
    top10_names_local[seq_along(spec_sel)],
    names(spec_sel)
  )
  mantel$spec <- spec_name_map[mantel$spec]
  
  # Remove non-significant Mantel links (p >= 0.05)
  mantel_sig <- mantel %>% filter(p < 0.05)
  cat(paste0("  Significant Mantel links (p < 0.05): ", nrow(mantel_sig), "\n"))
  
  # Plot
  p <- qcorrplot(linkET::correlate(env_sub),
                 type = "lower", diag = FALSE) +
    geom_square() +
    geom_couple(data   = mantel_sig,
                aes(colour = pd, size = rd),
                curvature = nice_curvature()) +
    scale_fill_gradientn(
      colors = RColorBrewer::brewer.pal(11, "RdBu")
    ) +
    scale_size_manual(values = c(0.5, 1.5, 3)) +
    scale_colour_manual(values = color_pal(3)) +
    guides(
      size  = guide_legend(title = "Mantel's r",
                           override.aes = list(color = "grey35"),
                           order = 2),
      color = guide_legend(title = "Mantel's p",
                           override.aes = list(size = 3),
                           order = 1),
      fill  = guide_colorbar(title = "Pearson's r", order = 3)
    ) +
    labs(title = paste0("Mantel Test — PETAR ", label)) +
    theme(
      plot.title   = element_text(hjust = 0.5, face = "bold", size = 14),
      legend.text  = element_text(size = 10),
      legend.title = element_text(size = 11, face = "bold"),
      axis.text    = element_text(size = 9)
    )
  
  print(p)
  ggsave(out_file, plot = p,
         width = 12, height = 10, dpi = 600, bg = "white")
  cat(paste0("  Saved: ", out_file, "\n"))
  
  # Save Mantel results table
  tsv_out <- gsub(".png", ".tsv", out_file)
  write.table(mantel, file = tsv_out,
              quote = FALSE, sep = "\t", row.names = FALSE)
  cat(paste0("  Saved: ", tsv_out, "\n"))
  
  return(p)
}


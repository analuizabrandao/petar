# STEP 9: Run for L and LB separately
# ============================================================

p_L  <- run_mantel_plot(ps_L,  "L",  "mantel_linkET_PETAR_L.png")
p_LB <- run_mantel_plot(ps_LB, "LB", "mantel_linkET_PETAR_LB.png")

# ============================================================
# STEP 10: Mantel — Depth groups vs Geochemical elements
# Spec groups = depth intervals, Env = geochemical elements
# ============================================================

run_mantel_depth <- function(ps, label, out_file) {
  
  cat(paste0("\n--- Running linkET Mantel (Depth) for: ", label, " ---\n"))
  
  # Build OTU matrix
  otu_rel <- build_otu_matrix(ps)
  
  # Build env matrix (geochemical only)
  env_mat <- build_env_matrix(ps)
  
  if (nrow(env_mat) < 3) {
    cat("  Not enough samples with complete environmental data\n")
    return(NULL)
  }
  
  # Align samples
  common_samples <- intersect(rownames(otu_rel), rownames(env_mat))
  cat(paste0("  Samples used: ", length(common_samples), "\n"))
  
  otu_sub <- otu_rel[common_samples, , drop = FALSE]
  env_sub <- env_mat[common_samples, , drop = FALSE]
  
  # Get Core.depth for each sample
  meta_df    <- data.frame(sample_data(ps))
  depth_vals <- meta_df$Core.depth[match(common_samples, rownames(meta_df))]
  
  # Get unique depth levels ordered
  depth_levels <- levels(droplevels(as.factor(depth_vals)))
  cat(paste0("  Depth levels: ", paste(depth_levels, collapse = ", "), "\n"))
  
  # Build spec_select: one group per depth interval
  spec_select <- list()
  for (i in seq_along(depth_levels)) {
    samps_at_depth <- common_samples[depth_vals == depth_levels[i]]
    if (length(samps_at_depth) > 0) {
      # Get column indices of ASVs present in these samples
      asv_present <- which(colSums(otu_sub[samps_at_depth, , drop = FALSE]) > 0)
      if (length(asv_present) > 0) {
        spec_select[[paste0("Depth_", depth_levels[i])]] <- asv_present
      }
    }
  }
  
  cat(paste0("  Depth groups built: ", length(spec_select), "\n"))
  
  if (length(spec_select) < 2) {
    cat("  Not enough depth groups\n")
    return(NULL)
  }
  
  # Run Mantel test
  mantel <- linkET::mantel_test(
    spec        = otu_sub,
    env         = env_sub,
    spec_select = spec_select
  ) %>%
    mutate(
      rd = cut(r,
               breaks = c(-Inf, 0.2, 0.4, Inf),
               labels = c("< 0.2", "0.2 - 0.4", ">= 0.4")),
      pd = cut(p,
               breaks = c(-Inf, 0.01, 0.05, Inf),
               labels = c("< 0.01", "0.01 - 0.05", ">= 0.05"))
    )
  
  # Filter non-significant links
  mantel_sig <- mantel %>% filter(p < 0.05)
  cat(paste0("  Significant Mantel links (p < 0.05): ", nrow(mantel_sig), "\n"))
  
  # Plot
  p <- qcorrplot(linkET::correlate(env_sub),
                 type = "lower", diag = FALSE) +
    geom_square() +
    geom_couple(data      = mantel_sig,
                aes(colour = pd, size = rd),
                curvature = nice_curvature()) +
    scale_fill_gradientn(
      colors = RColorBrewer::brewer.pal(11, "RdBu")
    ) +
    scale_size_manual(values = c(0.5, 1.5, 3)) +
    scale_colour_manual(values = color_pal(3)) +
    guides(
      size  = guide_legend(title = "Mantel\'s r",
                           override.aes = list(color = "grey35"),
                           order = 2),
      color = guide_legend(title = "Mantel\'s p",
                           override.aes = list(size = 3),
                           order = 1),
      fill  = guide_colorbar(title = "Pearson\'s r", order = 3)
    ) +
    labs(title = paste0("Mantel Test (Depth) — PETAR ", label)) +
    theme(
      plot.title   = element_text(hjust = 0.5, face = "bold", size = 14),
      legend.text  = element_text(size = 10),
      legend.title = element_text(size = 11, face = "bold"),
      axis.text    = element_text(size = 9)
    )
  
  print(p)
  ggsave(out_file, plot = p,
         width = 12, height = 10, dpi = 600, bg = "white")
  cat(paste0("  Saved: ", out_file, "\n"))
  
  tsv_out <- gsub(".png", ".tsv", out_file)
  write.table(mantel, file = tsv_out,
              quote = FALSE, sep = "\t", row.names = FALSE)
  cat(paste0("  Saved: ", tsv_out, "\n"))
  
  return(p)
}

